{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pipeline (tratar dados)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/pipeline.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Dashboard (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "dashboard/app.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
